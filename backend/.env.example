# Salin file ini menjadi .env lalu isi nilainya:
#   cp .env.example .env        (Windows PowerShell: Copy-Item .env.example .env)
# File .env tidak boleh di-commit. File ini (.env.example) boleh, jadi jangan isi rahasia asli di sini.
#
# Satu file ini dipakai di dua tempat:
#   1. aplikasi saat development  (./mvnw spring-boot:run, dibaca langsung oleh Spring)
#   2. backend/docker-compose.yml (dibaca otomatis oleh Docker Compose, baik dijalankan dari backend/
#      maupun lewat docker-compose.yml di root repo)
# Saat deploy, cukup ganti nilai bertanda [PRODUKSI]. Kode dan file compose tidak perlu diubah.

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Nama database. Dipakai compose untuk membuat database dan menyusun DB_URL di server.
DB_NAME=ewallet
DB_USERNAME=ewallet
# [PRODUKSI] Ganti dengan password yang kuat.
DB_PASSWORD=ewallet
# Hanya development: port database di komputer kamu (docker-compose.dev.yml). Ganti jika 5432 sudah terpakai,
# lalu samakan juga port di DB_URL di bawah.
DB_PORT=5432
# Hanya development (aplikasi jalan di luar Docker). Di backend/docker-compose.yml nilai ini otomatis diganti
# menjadi jdbc:postgresql://db:5432/${DB_NAME}, jadi tidak perlu diubah saat deploy.
DB_URL=jdbc:postgresql://localhost:5432/ewallet

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Port di dalam aplikasi/container. (Platform hosting yang mengisi PORT akan diutamakan.)
SERVER_PORT=8080
# Hanya docker-compose.prod.yml: alamat dan port di server tempat aplikasi bisa dibuka.
# 127.0.0.1 artinya hanya bisa diakses dari server itu sendiri (lewat reverse proxy). Jangan ganti ke 0.0.0.0.
APP_BIND=127.0.0.1
APP_PORT=8080
# [PRODUKSI] Isi false jika dokumentasi API (/swagger-ui.html) tidak ingin dibuka ke publik.
SWAGGER_ENABLED=true

# ---------------------------------------------------------------------------
# JWT dan sesi
# ---------------------------------------------------------------------------
# [PRODUKSI] Minimal 32 karakter, acak dan panjang. Contoh pembuatan: openssl rand -base64 48
JWT_SECRET=change-me-use-a-long-random-string-min-32-chars
# Masa berlaku access token dalam menit.
JWT_EXPIRATION_MINUTES=60
# Masa berlaku refresh token dalam hari.
JWT_REFRESH_EXPIRATION_DAYS=7
# [PRODUKSI] Isi true saat memakai HTTPS: cookie refresh token hanya akan dikirim lewat HTTPS.
# Biarkan false untuk development di http://localhost, kalau tidak login tidak akan bertahan.
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# [PRODUKSI] Alamat frontend yang boleh memanggil API, dipisah koma, tanpa garis miring di akhir.
# Contoh: https://wallet.contohmu.com
# Jika frontend dan API disajikan dari domain yang sama lewat reverse proxy (cara yang disarankan),
# browser tidak memakai CORS sama sekali, tetapi tetap isi dengan domain yang benar.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
