# Salin menjadi .env. Jangan di-commit. Penjelasan tiap variabel ada di README.

# Database
DB_NAME=ewallet
DB_USERNAME=ewallet
DB_PASSWORD=ewallet
DB_PORT=5432
# Produksi (PostgreSQL native): jdbc:postgresql://host.docker.internal:5432/ewallet
DB_URL=jdbc:postgresql://localhost:5432/ewallet

# Server
SERVER_PORT=8080
APP_PORT=8080
APP_BIND=127.0.0.1
SWAGGER_ENABLED=true

# JWT dan sesi (produksi: JWT_SECRET acak min. 32 karakter, COOKIE_SECURE=true)
JWT_SECRET=change-me-use-a-long-random-string-min-32-chars
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7
COOKIE_SECURE=false

# CORS (produksi: domain frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
