# Opsional. Salin menjadi .env hanya jika perlu mengubah pengaturan. Nilai di bawah adalah bawaan.
#
# Frontend tidak punya variabel yang ditanam saat build: semua permintaan memakai path relatif /api,
# jadi satu build bisa dipakai di domain mana pun. Pengaturan Docker di bawah dibaca saat container jalan.

# ---------------------------------------------------------------------------
# Development (pnpm dev)
# ---------------------------------------------------------------------------
# Port server development.
DEV_PORT=5173
# Alamat backend untuk proxy /api. Samakan dengan APP_PORT/SERVER_PORT di backend/.env.
DEV_API_TARGET=http://localhost:8080

# ---------------------------------------------------------------------------
# Docker (docker compose up)
# ---------------------------------------------------------------------------
# Alamat dan port di server tempat frontend bisa dibuka.
# 127.0.0.1 artinya hanya bisa diakses dari server itu sendiri (lewat reverse proxy). Jangan ganti ke 0.0.0.0.
WEB_BIND=127.0.0.1
WEB_PORT=3000
# Tujuan proxy /api dari dalam container. Bawaan http://app:8080 cocok bila dijalankan bersama backend
# lewat compose di root. Jika frontend dijalankan sendiri, arahkan ke backend, misalnya
# http://host.docker.internal:8080 (backend di komputer yang sama, Docker Desktop).
BACKEND_URL=http://app:8080
