# Opsional. Salin menjadi .env hanya jika perlu mengubah pengaturan development.
# Nilai di bawah adalah bawaan.
#
# Frontend tidak punya variabel produksi: semua permintaan memakai path relatif /api, jadi satu build
# bisa dipakai di domain mana pun. Di server, reverse proxy menyajikan folder dist/ dan meneruskan /api
# ke backend pada domain yang sama (supaya cookie refresh token SameSite=Strict ikut terkirim).

# Port server development (pnpm dev).
DEV_PORT=5173
# Alamat backend untuk proxy /api saat development. Samakan dengan SERVER_PORT di backend/.env.
DEV_API_TARGET=http://localhost:8080
