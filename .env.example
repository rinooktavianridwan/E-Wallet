# Salin file ini menjadi .env lalu isi nilainya:
#   cp .env.example .env        (Windows PowerShell: Copy-Item .env.example .env)
# File .env tidak boleh di-commit. File ini (.env.example) boleh, jadi jangan isi rahasia asli di sini.

# --- Database (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/ewallet
DB_USERNAME=ewallet
DB_PASSWORD=change-me

# --- Server ---
SERVER_PORT=8080

# --- JWT ---
# Minimal 32 karakter, acak dan panjang.
JWT_SECRET=change-me-use-a-long-random-string
JWT_EXPIRATION_MINUTES=60

# --- CORS: alamat frontend yang boleh memanggil API (dipakai nanti) ---
# Pisahkan dengan koma. Untuk produksi, isi dengan domain frontend yang sebenarnya.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
